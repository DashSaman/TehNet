[Unit]
Description=Private TehNet WordPress files and transactional SQL backup
After=docker.service
ConditionPathExists=/opt/tehnet/compose.yaml

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/tehnet/bin/store-backup.sh
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=600
MemoryMax=256M
PrivateTmp=true

